{
  "name": "layered",
  "version": "1.0.0",
  "description": "Turns your local forecast into what to wear.",
  "license": "AGPL-3.0-or-later",
  "author": "Daniel Woo (torrentsec)",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/torrentsec/Layered"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "icons": "node scripts/icons.mjs",
    "deploy": "wrangler pages deploy dist --project-name layered --branch main"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261125.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/jost": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.11",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "workbox-window": "^7.4.1",
    "wrangler": "^4.168.0"
  }
}
